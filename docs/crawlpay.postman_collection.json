  "item": [
    {
      "name": "1. Core Audits & Intelligence (AEO & GEO)",
      "item": [
        {
          "name": "POST /api/audit (Quick Mode with AEO & GEO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{targetUrl}}\",\n  \"mode\": \"quick\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/audit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audit"]
            },
            "description": "Executes a fast deterministic single-page audit evaluating technical SEO, Core Web Vitals, AEO (Answer Engine Optimization), and GEO (Generative Engine Optimization) with RFC 9309 bot evaluation and on-chain Celo attribution."
          },
          "response": []
        },
        {
          "name": "POST /api/audit (Full Multi-Page Crawl)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{targetUrl}}\",\n  \"mode\": \"full\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/audit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "audit"]
            },
            "description": "Executes deep multi-page BFS crawl (up to 50 pages) discovering subpages, internal canonical mismatches, sitemaps, duplicate content simhashes, and sitewide AEO/GEO signals."
          },
          "response": []
        },
        {
          "name": "POST /api/compare (Head-to-Head Competitor Intelligence)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUrl\": \"{{targetUrl}}\",\n  \"competitorUrl\": \"{{competitorUrl}}\",\n  \"mode\": \"quick\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/compare",
              "host": ["{{baseUrl}}"],
              "path": ["api", "compare"]
            },
            "description": "Benchmarks primary domain against a rival domain: calculates score delta, estimated LCP speed advantage, side-by-side AEO & GEO scores, and produces a 3-step actionable win plan."
          },
          "response": []
        }
      ]
    },
